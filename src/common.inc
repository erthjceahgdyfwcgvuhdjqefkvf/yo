; ---------------------------------------------------------------- macros ---
; Function frame with all callee-saved GPRs pushed and %1 bytes of 16-byte
; aligned locals at [rsp]. Keeps rsp 16-byte aligned for calls.
%macro ENTER_FN 1
    push rbp
    mov rbp, rsp
    push rbx
    push r12
    push r13
    push r14
    push r15
    sub rsp, %1 + 8
%endmacro

%macro LEAVE_FN 0
    lea rsp, [rbp - 40]
    pop r15
    pop r14
    pop r13
    pop r12
    pop rbx
    pop rbp
    ret
%endmacro

